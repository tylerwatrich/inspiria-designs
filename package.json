{
  "name": "inspiria-designs",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "vercel-build": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap && next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate": "tsx --env-file=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@esbuild-kit/core-utils": "^3.3.2",
    "@lexical/list": "^0.35.0",
    "@lexical/selection": "^0.35.0",
    "@next/third-parties": "^16.0.1",
    "@payloadcms/admin-bar": "3.77.0",
    "@payloadcms/db-postgres": "3.77.0",
    "@payloadcms/live-preview-react": "3.77.0",
    "@payloadcms/next": "3.77.0",
    "@payloadcms/payload-cloud": "3.77.0",
    "@payloadcms/plugin-form-builder": "3.77.0",
    "@payloadcms/plugin-nested-docs": "3.77.0",
    "@payloadcms/plugin-redirects": "3.77.0",
    "@payloadcms/plugin-search": "3.77.0",
    "@payloadcms/plugin-seo": "3.77.0",
    "@payloadcms/richtext-lexical": "3.77.0",
    "@payloadcms/storage-vercel-blob": "^3.77.0",
    "@payloadcms/ui": "3.77.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@xmldom/xmldom": "^0.8.11",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lexical": "0.35.0",
    "lucide-react": "^0.553.0",
    "next": "16.0.1",
    "next-sitemap": "^4.2.3",
    "node-html-parser": "^7.0.2",
    "optional": "^0.1.4",
    "payload": "3.77.0",
    "pnpm": "^10.21.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.66.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/xml2js": "^0.4.14",
    "@types/xmldom": "^0.1.34",
    "@vitejs/plugin-react": "5.1.0",
    "copyfiles": "^2.4.1",
    "dotenv": "17.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.0.1",
    "jsdom": "27.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.8"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
